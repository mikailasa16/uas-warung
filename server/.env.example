NODE_ENV=production
PORT=4000
# Daftar origin web yang diizinkan (pisahkan dengan koma). Di mode development semua origin diizinkan.
CORS_ORIGINS=https://pos.domainanda.com

# MySQL dengan password / AWS RDS:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/warung_pos"
DATABASE_URL="mysql://root:password@localhost:3306/warung_pos"

# Isi dengan string acak panjang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=12h
