# File konfigurasi LOKAL (development). Jangan dipakai apa adanya di server produksi.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# XAMPP: user root tanpa password. Database "warung_pos" dibuat otomatis oleh prisma db push.
DATABASE_URL="mysql://root@localhost:3306/warung_pos"

JWT_SECRET=warung-pos-dev-secret-ganti-sebelum-deploy-0123456789abcdef
JWT_EXPIRES_IN=12h
